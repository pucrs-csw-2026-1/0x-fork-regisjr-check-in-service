# Application
PORT=3000

# Auth Service (Python FastAPI — emite JWTs RS256)
# JWKS: ${AUTH_SERVICE_URL}/.well-known/jwks.json
AUTH_SERVICE_URL=http://localhost:8080

# AWS
AWS_REGION=us-east-1

# DynamoDB (sobrescrito pelo docker-compose para http://dynamodb-local:8000)
DYNAMODB_TABLE_NAME=check-in-service
DYNAMODB_ENDPOINT=http://localhost:8000

# SNS (sobrescrito pelo docker-compose para http://localstack:4566)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:regisjr-check-in-events
SNS_ENDPOINT=http://localhost:4566

# Secrets Manager (sobrescrito pelo docker-compose)
SECRETS_MANAGER_ENDPOINT=http://localhost:4566
QR_JWT_SECRET_ID=regisjr/check-in/qr-jwt-secret

# Fallback para QR JWT (quando Secrets Manager não disponível)
QR_JWT_SECRET=dev-qr-secret-change-in-production

# QR Code TTL
QR_JWT_TTL_SECONDS=300

# Registration Service
REGISTRATION_SERVICE_URL=http://localhost:3001
REGISTRATION_SERVICE_TIMEOUT_MS=500
