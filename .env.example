# Application
PORT=3000

# AWS
AWS_REGION=us-east-1

# DynamoDB — Ministack compartilhada (US-08: uma só, a do auth-infra em :4566)
DYNAMODB_TABLE_NAME=check-in-service
DYNAMODB_ENDPOINT=http://localhost:4566

# SNS — publica no tópico que o consumidor de SQS do Metrics (T2) assina
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:checkin-events
SNS_ENDPOINT=http://localhost:4566

# Auth (T1) — valida o JWT de usuário via JWKS do Auth (RS256), auth único da
# plataforma (US-08). host.docker.internal:8080 quando dentro da stack.
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Secrets Manager (QR code). AUTH_JWT_SECRET* abaixo é legado (o auth de usuário
# passou a validar via JWKS acima) — mantido só para o QR/compat.
SECRETS_MANAGER_ENDPOINT=http://localhost:4566
QR_JWT_SECRET_ID=regisjr/check-in/qr-jwt-secret
AUTH_JWT_SECRET_ID=regisjr/auth/jwt-secret

# Fallback secrets (used when Secrets Manager is unavailable or in local dev without LocalStack)
QR_JWT_SECRET=dev-qr-secret-change-in-production
AUTH_JWT_SECRET=dev-auth-secret-change-in-production

# QR Code
QR_JWT_TTL_SECONDS=300

# Registration Service
REGISTRATION_SERVICE_URL=http://localhost:3001
REGISTRATION_SERVICE_TIMEOUT_MS=500
